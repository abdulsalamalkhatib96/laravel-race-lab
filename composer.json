{
    "name": "race-lab/laravel-race-lab",
    "description": "Deterministic concurrency and race-condition testing for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "race-condition", "concurrency", "testing", "deterministic", "database", "locking"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/serializable-closure": "^2.0",
        "symfony/process": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0|^13.0"
    },
    "suggest": {
        "illuminate/redis": "Required when using the Redis coordinator."
    },
    "autoload": {
        "psr-4": {
            "RaceLab\\LaravelRaceLab\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RaceLab\\LaravelRaceLab\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RaceLab\\LaravelRaceLab\\LaravelRaceLabServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
